---
import '../styles/global.css';
import { SITE } from '../site.config';
import { withBase } from '../lib/url';

interface ArticleMeta {
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  article?: ArticleMeta;
  noindex?: boolean;
}

const { title, description, ogImage, article, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const siteBaseURL = new URL(withBase('/'), Astro.site);
const basePath = siteBaseURL.pathname.replace(/\/+$/, '');
const ogImagePath = ogImage
  ? (basePath && ogImage.startsWith(`${basePath}/`) ? ogImage.slice(basePath.length + 1) : ogImage.replace(/^\/+/, ''))
  : undefined;
const absoluteOgImage = ogImagePath ? new URL(ogImagePath, siteBaseURL) : undefined;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (path: string) => currentPath === (withBase(path).replace(/\/+$/, '') || '/');
const isAboutPage = currentPath === (withBase('/about').replace(/\/+$/, '') || '/');
const authorURL = new URL(withBase('/about/'), Astro.site).href;

const structuredData = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonicalURL.href,
      mainEntityOfPage: canonicalURL.href,
      datePublished: article.pubDate.toISOString(),
      dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
      author: { '@type': 'Person', name: SITE.author, url: authorURL },
      publisher: { '@type': 'Organization', name: SITE.name },
      image: absoluteOgImage?.href,
      keywords: article.tags?.join(', '),
    }
  : isAboutPage
    ? {
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        name: title,
        description,
        url: canonicalURL.href,
        mainEntity: {
          '@type': 'Person',
          name: SITE.author,
          url: authorURL,
          email: `mailto:${SITE.contactEmail}`,
          worksFor: { '@type': 'Organization', name: SITE.name },
          description: 'Independent writer and reviewer focused on the practical use of AI tools and software.',
        },
      }
    : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.name,
      description: SITE.description,
      url: new URL(withBase('/'), Astro.site).href,
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#185adb" />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} RSS feed`}
      href={withBase('/rss.xml')}
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {absoluteOgImage && <meta property="og:image:alt" content={title} />}
    {article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
    {article?.updatedDate && (
      <meta property="article:modified_time" content={article.updatedDate.toISOString()} />
    )}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Add the AdSense script here only after the site is approved. -->
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="wrapper">
        <a class="site-title" href={withBase('/')}>{SITE.name}</a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={withBase('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
          <a href={withBase('/about')} aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
          <a href={withBase('/contact')} aria-current={isCurrent('/contact') ? 'page' : undefined}>Contact</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="wrapper">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrapper">
        <p>&copy; {new Date().getFullYear()} {SITE.name}. Independent AI tool analysis.</p>
        <nav aria-label="Footer navigation">
          <a href={withBase('/privacy-policy')}>Privacy Policy</a>
          <a href={withBase('/about')}>About</a>
          <a href={withBase('/contact')}>Contact</a>
          <a href={withBase('/rss.xml')}>RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
