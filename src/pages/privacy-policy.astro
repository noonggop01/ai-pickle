---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const title = 'Privacy Policy';
const description = `Privacy policy for ${SITE.name}, including how contact information, analytics, cookies, and future advertising would be handled.`;
const lastUpdated = 'August 3, 2026';
---

<BaseLayout title={title} description={description}>
  <article class="post">
    <h1>Privacy Policy</h1>
    <p class="post-meta">Last updated: {lastUpdated}</p>

    <p>
      This policy explains how {SITE.name} handles information when you visit this website.
    </p>

    <h2>Information we collect</h2>
    <p>
      You do not need an account or personal information to read the site. If you email
      us, we retain that correspondence only as needed to respond and keep a record of the
      conversation.
    </p>

    <h2>Cookies, analytics, and advertising</h2>
    <p>
      {SITE.name} does not currently run third-party analytics, display advertising, or
      affiliate tracking. The site itself does not intentionally set advertising cookies.
    </p>
    <p>
      If Google AdSense, analytics, or another advertising service is enabled later, this
      policy will be updated before or when that service goes live. Those providers may
      then use cookies or similar technology according to their own privacy policies, and
      any legally required consent controls will be added.
    </p>

    <h2>Third-party links</h2>
    <p>
      Articles link to external sources and products. We do not control, and are not
      responsible for, the privacy practices of those third-party sites.
    </p>

    <h2>Children's privacy</h2>
    <p>
      This site is not directed at children under 13, and we do not knowingly collect
      personal information from children under 13.
    </p>

    <h2>Changes to this policy</h2>
    <p>
      Material changes will be posted here with a new "Last updated" date.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about this policy? Email
      <a href={`mailto:${SITE.contactEmail}`}> {SITE.contactEmail}</a>.
    </p>
  </article>
</BaseLayout>
