{
  "name": "ai-pickle-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --test scripts/lib/telegram.test.mjs scripts/lib/content-validation.test.mjs",
    "validate:content": "node scripts/validate-published-content.mjs",
    "check": "npm test && npm run validate:content && npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "research:keywords": "node scripts/agents/keyword-research.mjs",
    "write:draft": "node scripts/agents/draft-writer.mjs",
    "make:images": "node scripts/agents/image-agent.mjs",
    "qa:check": "node scripts/agents/qa-agent.mjs",
    "pipeline": "node scripts/pipeline.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.6"
  }
}
